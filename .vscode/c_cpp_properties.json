{
    "configurations": [
        {
            "name": "MinGW64",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/**",
                "C:/MinGW64/include",
                "C:/MinGW64/x86_64-w64-mingw32/include/**"
            ],
            "defines": [
                "_GLFW_WIN32",
                "YG_ENABLE_EVENTS"
            ],
            "compilerPath": "C:/MinGW64/bin/gcc.exe",
            "cStandard": "c17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ],
    "version": 4
}